# Leave REACT_APP_AGENTS_URL empty in development: package.json "proxy" forwards /api to localhost:8000.
# For a separately hosted API set it, e.g. REACT_APP_AGENTS_URL=https://agents.midbank.internal
REACT_APP_AGENTS_URL=
# Same value as one of API_KEYS on the service. Leave empty when the service runs with DEV_MODE=1.
REACT_APP_API_KEY=
